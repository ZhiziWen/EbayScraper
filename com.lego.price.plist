<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lego.price</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/zhiziwen/Documents/vibe coding项目/ebay code/run_pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zhiziwen/Documents/vibe coding项目/ebay code</string>

    <!-- Run on the 1st and 15th of every month at 09:00 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Day</key>    <integer>1</integer>
            <key>Hour</key>   <integer>9</integer>
            <key>Minute</key> <integer>0</integer>
        </dict>
        <dict>
            <key>Day</key>    <integer>15</integer>
            <key>Hour</key>   <integer>9</integer>
            <key>Minute</key> <integer>0</integer>
        </dict>
    </array>

    <!-- If the Mac was asleep at scheduled time, run immediately on next wake -->
    <key>StandardOutPath</key>
    <string>/Users/zhiziwen/Documents/vibe coding项目/ebay code/pipeline.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zhiziwen/Documents/vibe coding项目/ebay code/pipeline.log</string>
</dict>
</plist>
